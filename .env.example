# Postgres connection (Supabase/Neon in production, local Postgres in dev)
DATABASE_URL=postgres://postgres@localhost:5499/woofers

# Optional: Google Maps Platform key (Geocoding + Maps). Without it the app still
# works; addresses are not geocoded and "Directions" uses the address text.
GOOGLE_MAPS_API_KEY=

# Public URL of the app, used in links sent to clients
APP_URL=http://localhost:3000

# Free email through the business Gmail (Google account → Security → 2-Step Verification
# → App passwords). Without these, emails are not sent.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Long random text. The hourly job calls /api/cron/messages with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Required in production: the code asked once when creating the owner login.
SETUP_CODE=
